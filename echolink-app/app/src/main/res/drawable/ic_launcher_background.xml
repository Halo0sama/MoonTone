<?xml version="1.0" encoding="utf-8"?>
<!--
  MoonTone adaptive-icon background: "Aurora Night" gradient — brand violet (#6C5CE7) through
  primary (#5C54A8) into the mint signal colour (#00BFA6), with two faint aurora glows.
  Drawn as a full-canvas vector so every adaptive-icon mask (circle, squircle, rounded square)
  sees edge-to-edge colour with no transparent corners.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base violet -> mint diagonal gradient. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="2"
                android:endX="102"
                android:endY="106">
                <item android:offset="0.0" android:color="#FF6C5CE7" />
                <item android:offset="0.5" android:color="#FF5C54A8" />
                <item android:offset="1.0" android:color="#FF00BFA6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint moonlight glow, top-left. -->
    <path
        android:fillColor="#14FFFFFF"
        android:pathData="M34,26 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0" />

    <!-- Faint mint signal glow, bottom-right. -->
    <path
        android:fillColor="#2671F2D9"
        android:pathData="M84,86 m-38,0 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0" />
</vector>
